#
# Code style, after EDMC's own .flake8 (EDMarketConnector 6.1.2): PEP 8 with
# lines up to 120 characters. CI runs `python -m flake8` with this file.
#
# EDMC also sets max-complexity = 15. Since 4.11 every module of the plugin
# layer (load.py and the modules split from it) keeps it. 36 older functions
# of the helper modules and the FIS are still above it; tests/complexity.py
# (run by CI after flake8) lets none of them grow and no new one above 15:
#     python tests/complexity.py

[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    # third-party, shipped unchanged (see their SOURCE.md)
    edts_pgnames/pgdata.py,
    regionmap/RegionMapData.py,
    FIS/fis/vendor,
    FIS/web/vendor
# test data reads best on one line (journal events, tables), and small
# lambdas build rows; the code under test keeps the full rules
per-file-ignores =
    FIS/tests/*.py: E501, E731, E128
    tests/*.py: E501
